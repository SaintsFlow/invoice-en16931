# OCR engine: tesseract works today, paddle arrives in wave 6
OCR_ENGINE=tesseract

# Languages tesseract loads, joined with +. Austrian invoices are German, and
# export paperwork is often English, so both are installed in the image.
OCR_LANGS=eng+deu

# LLM used for extraction. Key from platform.openai.com. Without a key the
# service still starts and still does OCR, it just cannot read out the fields.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Point this at a gateway or a compatible endpoint. Leave it out for OpenAI itself.
OPENAI_BASE_URL=https://api.openai.com/v1

# How long one call to the model may take, in seconds
OPENAI_TIMEOUT_SECONDS=60

# How much OCR text is sent to the model. This is the cost ceiling: a long
# multi page scan would otherwise eat the whole context window and the budget.
MAX_OCR_CHARS=20000

# Where the file adapter writes its output
OUTPUT_DIR=./out

# debug | info | warning | error
LOG_LEVEL=info
